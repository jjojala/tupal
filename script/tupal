#!/bin/sh

default_url=${TUPAL_URL:-http://127.0.0.1:8085}
url=$default_url
action=
resource=
id=
competition=
title=
name=
date=
first_start_time=
first_bib=0
start_interval=PT0S
start_group=
competitor_class=
bib=0
start_time_offset=PT0S
finish_time=
status=0
sequence_no=
confirmed_time_entry_id=
have_id=false
have_title=false
have_date=false
have_first_start_time=false
have_competition=false
have_start_group=false
have_competitor_class=false
have_name=false
have_bib=false
have_sequence_no=false
have_confirmed_time_entry_id=false

usage() {
    cat <<'EOF'
Usage:
  tupal [--url URL] create competition [--id ID] --title TITLE --date DATE
  tupal [--url URL] create start-group [--id ID] --competition ID --title TITLE
      --first-start-time TIME [--first-bib NUMBER] [--start-interval DURATION]
  tupal [--url URL] create class [--id ID] --competition ID --title TITLE
      --start-group ID
  tupal [--url URL] create competitor [--id ID] --competition ID --class ID
      --name NAME [--bib NUMBER] [--start-time-offset DURATION]
      [--finish-time TIME] [--status NUMBER]
  tupal [--url URL] create finish-time-entry [--id ID] --competition ID
      --finish-time TIME [--status NUMBER]
  tupal [--url URL] create finish-bib-entry [--id ID] --competition ID
      --sequence-no NUMBER [--bib NUMBER] [--status NUMBER]
      [--confirmed-time-entry-id ID]

The server URL defaults to TUPAL_URL or http://127.0.0.1:8085.
IDs are generated by the server unless --id is provided.
The created resource ID is printed to stdout.
EOF
}

fail() {
    printf 'tupal: %s\n' "$*" >&2
    exit 1
}

require_value() {
    [ "$#" -ge 2 ] || fail "option $1 requires a value"
}

valid_path_id() {
    case $1 in
        ''|*[!A-Za-z0-9._~-]*) return 1 ;;
        *) return 0 ;;
    esac
}

json_string() {
    case $1 in
        *"
"*) fail "JSON values must not contain line breaks" ;;
    esac
    escaped=$(printf '%s' "$1" | sed 's/[\\"]/\\&/g') ||
        fail "could not encode JSON value"
    printf '"%s"' "$escaped"
}

while [ "$#" -gt 0 ]; do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        --url)
            require_value "$@"
            url=$2
            shift 2
            ;;
        --url=*)
            url=${1#--url=}
            shift
            ;;
        create)
            [ -z "$action" ] || fail "unexpected argument: $1"
            action=create
            shift
            ;;
        competition|start-group|class|finish-time-entry|finish-bib-entry)
            [ -z "$resource" ] || fail "unexpected argument: $1"
            resource=$1
            shift
            ;;
        competitor)
            [ -z "$resource" ] || fail "unexpected argument: $1"
            resource=$1
            shift
            ;;
        --id)
            require_value "$@"
            id=$2
            have_id=true
            shift 2
            ;;
        --title)
            require_value "$@"
            title=$2
            have_title=true
            shift 2
            ;;
        --date)
            require_value "$@"
            date=$2
            have_date=true
            shift 2
            ;;
        --competition)
            require_value "$@"
            competition=$2
            have_competition=true
            shift 2
            ;;
        --first-start-time)
            require_value "$@"
            first_start_time=$2
            have_first_start_time=true
            shift 2
            ;;
        --first-bib)
            require_value "$@"
            first_bib=$2
            shift 2
            ;;
        --start-interval)
            require_value "$@"
            start_interval=$2
            shift 2
            ;;
        --start-group)
            require_value "$@"
            start_group=$2
            have_start_group=true
            shift 2
            ;;
        --class)
            require_value "$@"
            competitor_class=$2
            have_competitor_class=true
            shift 2
            ;;
        --name)
            require_value "$@"
            name=$2
            have_name=true
            shift 2
            ;;
        --bib)
            require_value "$@"
            bib=$2
            have_bib=true
            shift 2
            ;;
        --start-time-offset)
            require_value "$@"
            start_time_offset=$2
            shift 2
            ;;
        --finish-time)
            require_value "$@"
            finish_time=$2
            shift 2
            ;;
        --status)
            require_value "$@"
            status=$2
            shift 2
            ;;
        --sequence-no)
            require_value "$@"
            sequence_no=$2
            have_sequence_no=true
            shift 2
            ;;
        --confirmed-time-entry-id)
            require_value "$@"
            confirmed_time_entry_id=$2
            have_confirmed_time_entry_id=true
            shift 2
            ;;
        *)
            fail "unknown argument: $1 (use --help for usage)"
            ;;
    esac
done

[ "$action" = create ] || fail "expected 'create' command (use --help for usage)"
[ -n "$resource" ] || fail "expected resource type after 'create' (use --help for usage)"
[ -n "$url" ] || fail "server URL must not be empty"

case $resource in
    competition)
        [ "$have_title" = true ] || fail "--title is required"
        [ "$have_date" = true ] || fail "--date is required for a competition"
        route=/rest/competition/
        if [ "$have_id" = true ]; then
            id_json=$(json_string "$id")
        else
            id_json=null
        fi
        payload=$(printf '{"id":%s,"title":%s,"date":%s}' \
            "$id_json" "$(json_string "$title")" "$(json_string "$date")")
        ;;
    start-group)
        [ "$have_title" = true ] || fail "--title is required"
        [ "$have_competition" = true ] || fail "--competition is required for a start group"
        [ "$have_first_start_time" = true ] || fail "--first-start-time is required for a start group"
        case $first_bib in
            ''|*[!0-9]*) fail "--first-bib must be an integer from 0 to 65535" ;;
        esac
        first_bib=$(printf '%s' "$first_bib" | sed 's/^0*//')
        [ -n "$first_bib" ] || first_bib=0
        [ "${#first_bib}" -le 5 ] &&
            [ "$first_bib" -le 65535 ] || fail "--first-bib must be an integer from 0 to 65535"
        valid_path_id "$competition" || fail "competition ID contains unsupported URL characters"
        route="/rest/competition/$competition/start_group/"
        if [ "$have_id" = true ]; then
            id_json=$(json_string "$id")
        else
            id_json=null
        fi
        payload=$(printf '{"id":%s,"title":%s,"first_start_time":%s,"first_bib":%s,"start_interval":%s}' \
            "$id_json" "$(json_string "$title")" "$(json_string "$first_start_time")" \
            "$first_bib" "$(json_string "$start_interval")")
        ;;
    class)
        [ "$have_title" = true ] || fail "--title is required"
        [ "$have_competition" = true ] || fail "--competition is required for a class"
        [ "$have_start_group" = true ] || fail "--start-group is required for a class"
        valid_path_id "$competition" || fail "competition ID contains unsupported URL characters"
        route="/rest/competition/$competition/competition_class/"
        if [ "$have_id" = true ]; then
            id_json=$(json_string "$id")
        else
            id_json=null
        fi
        payload=$(printf '{"id":%s,"title":%s,"start_group_id":%s}' \
            "$id_json" "$(json_string "$title")" "$(json_string "$start_group")")
        ;;
    competitor)
        [ "$have_competition" = true ] || fail "--competition is required for a competitor"
        [ "$have_competitor_class" = true ] || fail "--class is required for a competitor"
        [ "$have_name" = true ] || fail "--name is required for a competitor"
        case $bib in
            ''|*[!0-9]*) fail "--bib must be an integer from 0 to 65535" ;;
        esac
        bib=$(printf '%s' "$bib" | sed 's/^0*//')
        [ -n "$bib" ] || bib=0
        [ "${#bib}" -le 5 ] &&
            [ "$bib" -le 65535 ] || fail "--bib must be an integer from 0 to 65535"
        case $status in
            ''|*[!0-9]*) fail "--status must be an integer from 0 to 3" ;;
        esac
        [ "${#status}" -eq 1 ] && [ "$status" -le 3 ] ||
            fail "--status must be an integer from 0 to 3"
        valid_path_id "$competition" || fail "competition ID contains unsupported URL characters"
        route="/rest/competition/$competition/competitor/"
        if [ "$have_id" = true ]; then
            id_json=$(json_string "$id")
        else
            id_json=null
        fi
        payload=$(printf '{"id":%s,"comp_class_id":%s,"bib":%s,"name":%s,"start_time_offset":%s,"finish_time":%s,"status":%s}' \
            "$id_json" "$(json_string "$competitor_class")" "$bib" \
            "$(json_string "$name")" "$(json_string "$start_time_offset")" \
            "$(json_string "$finish_time")" "$status")
        ;;
    finish-time-entry)
        [ "$have_competition" = true ] || fail "--competition is required for a finish-time entry"
        [ -n "$finish_time" ] || fail "--finish-time is required for a finish-time entry"
        case $status in
            ''|*[!0-9]*) fail "--status must be an integer from 0 to 3" ;;
        esac
        [ "${#status}" -eq 1 ] && [ "$status" -le 3 ] ||
            fail "--status must be an integer from 0 to 3"
        valid_path_id "$competition" || fail "competition ID contains unsupported URL characters"
        route="/rest/competition/$competition/finish_time_entry/"
        if [ "$have_id" = true ]; then
            id_json=$(json_string "$id")
        else
            id_json=null
        fi
        payload=$(printf '{"id":%s,"finish_time":%s,"status":%s}' \
            "$id_json" "$(json_string "$finish_time")" "$status")
        ;;
    finish-bib-entry)
        [ "$have_competition" = true ] || fail "--competition is required for a finish-bib entry"
        [ "$have_sequence_no" = true ] || fail "--sequence-no is required for a finish-bib entry"
        case $sequence_no in
            ''|*[!0-9]*) fail "--sequence-no must be a non-negative integer" ;;
        esac
        sequence_no=$(printf '%s' "$sequence_no" | sed 's/^0*//')
        [ -n "$sequence_no" ] || sequence_no=0
        [ "${#sequence_no}" -le 10 ] &&
            { [ "${#sequence_no}" -lt 10 ] || [ "$sequence_no" -le 2147483647 ]; } ||
            fail "--sequence-no must be a non-negative 32-bit integer"
        case $status in
            ''|*[!0-9]*) fail "--status must be an integer from 0 to 3" ;;
        esac
        [ "${#status}" -eq 1 ] && [ "$status" -le 3 ] ||
            fail "--status must be an integer from 0 to 3"
        if [ "$have_bib" = true ]; then
            case $bib in
                ''|*[!0-9]*) fail "--bib must be a non-negative integer from 0 to 65535" ;;
            esac
            bib=$(printf '%s' "$bib" | sed 's/^0*//')
            [ -n "$bib" ] || bib=0
            [ "${#bib}" -le 5 ] &&
                [ "$bib" -le 65535 ] || fail "--bib must be a non-negative integer from 0 to 65535"
            bib_json=$bib
        else
            bib_json=null
        fi
        valid_path_id "$competition" || fail "competition ID contains unsupported URL characters"
        route="/rest/competition/$competition/finish_bib_entry/"
        if [ "$have_id" = true ]; then
            id_json=$(json_string "$id")
        else
            id_json=null
        fi
        if [ "$have_confirmed_time_entry_id" = true ]; then
            confirmed_time_entry_id_json=$(json_string "$confirmed_time_entry_id")
        else
            confirmed_time_entry_id_json=null
        fi
        payload=$(printf '{"id":%s,"sequence_no":%s,"bib":%s,"status":%s,"confirmed_time_entry_id":%s}' \
            "$id_json" "$sequence_no" "$bib_json" "$status" "$confirmed_time_entry_id_json")
        ;;
esac

newline='
'
response=$(curl --silent --show-error --write-out "${newline}%{http_code}" \
    --request POST \
    --header 'Accept: application/json' \
    --header 'Content-Type: application/json' \
    --data "$payload" \
    "${url%/}$route") || fail "request to $url failed"
http_status=${response##*"$newline"}
response_body=${response%"$newline$http_status"}

case $http_status in
    2??) ;;
    *) fail "server returned HTTP $http_status: $response_body" ;;
esac

created_id=$(printf '%s\n' "$response_body" |
    sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' |
    sed -n '1p')
[ -n "$created_id" ] || fail "server response did not contain a resource ID"
printf '%s\n' "$created_id"
